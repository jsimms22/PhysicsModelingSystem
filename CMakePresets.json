{
  "version": 3,
    "configurePresets": [
        {
            "name": "default-debug",
            "displayName": "Debug Mingw Build",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "PLATFORM_IMPL_OS": "GLFWContext",
                "PLATFORM_IMPL_RENDER": "OpenGL"
            }
        },
        {
            "name": "default-release",
            "displayName": "Release Mingw Build",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "PLATFORM_IMPL_OS": "GLFWContext",
                "PLATFORM_IMPL_RENDER": "OpenGL"
            }
        },
        {
            "name": "msvc-debug",
            "displayName": "Debug MSVC Build",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "PLATFORM_IMPL_OS": "GLFWContext",
                "PLATFORM_IMPL_RENDER": "OpenGL"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": [ "Windows" ]
                }
            }
        },
        {
            "name": "msvc-release",
            "displayName": "Release MSVC Build",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "PLATFORM_IMPL_OS": "GLFWContext",
                "PLATFORM_IMPL_RENDER": "OpenGL"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": [ "Windows" ]
                }
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug-build",
            "displayName": "Build Debug",
            "configurePreset": "default-debug"
        },
        {
            "name": "release-build",
            "displayName": "Build Release",
            "configurePreset": "default-release"
        },
        {
            "name": "debug-mscv-build",
            "displayName": "Build MSCV Debug",
            "configurePreset": "msvc-debug"
        },
        {
            "name": "release-mscv-build",
            "displayName": "Build MSCV Release",
            "configurePreset": "msvc-release"
        }
    ]
}